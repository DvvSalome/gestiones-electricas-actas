{
  "cleanUrls": true,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "rewrites": [
    { "source": "/publicidad", "destination": "/web/publicidad/index.html" },
    { "source": "/publicidad/(.*)", "destination": "/web/publicidad/$1" },
    { "source": "/actas", "destination": "/web/actas/index.html" },
    { "source": "/actas/(.*)", "destination": "/web/actas/$1" }
  ]
}
