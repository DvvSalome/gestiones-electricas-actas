{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "destination": "https://actas.gestioneselectricas.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "destination": "https://actas.gestioneselectricas.com/:path*",
      "permanent": true
    }
  ]
}
